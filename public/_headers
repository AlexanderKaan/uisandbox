# Cloudflare Pages / Netlify headers.
#
# The service worker must never be stale: a cached sw.js is a cached sandbox.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /

# Hashed assets are immutable by name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The app itself, and everything else: sensible defaults. No CSP script-src
# yet — the sandbox needs Google Fonts, blob: fonts and CORS zip fetches, and a
# policy is measured against the hold-outs before it is set (notes/roadmap.md).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: frame-ancestors 'self'
  X-Frame-Options: SAMEORIGIN

# Text files for crawlers and models, and the images cards use.
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
/robots.txt
  Content-Type: text/plain; charset=utf-8
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
/og.png
  Cache-Control: public, max-age=86400
/site.webmanifest
  Content-Type: application/manifest+json

# Sample builds: real open-source builds (MIT), a day of cache is plenty.
/samples/*
  Cache-Control: public, max-age=86400
